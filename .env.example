# ── LLM Configuration ───────────────────────────────────────────────────────
# Choose either 'openai' or 'ollama'
MODEL_TYPE=openai

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Ollama (used when MODEL_TYPE=ollama)
OLLAMA_MODEL=llama2
OLLAMA_BASE_URL=http://localhost:11434

# LLM Generation Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500
CONVERSATION_HISTORY_TURNS=3

# ── Vector Database ──────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── Embedding & Reranking ────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Retrieval ────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=20
TOP_N_RERANK=5

# ── Request Limits ───────────────────────────────────────────────────────────
MAX_QUERY_LENGTH=2000
MAX_FILE_SIZE_MB=50

# ── Authentication ───────────────────────────────────────────────────────────
# Leave blank to disable auth (fine for local development).
# Set a strong random string for production.
# Example: API_KEY=$(openssl rand -hex 32)
API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON array of allowed origins (the frontend dev server is pre-configured).
# Example: CORS_ORIGINS=["http://localhost:5173","https://your-domain.com"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ── Rate Limiting ────────────────────────────────────────────────────────────
# Format: "N/period" — period can be second, minute, hour
RATE_LIMIT=30/minute

# ── Session Storage ──────────────────────────────────────────────────────────
# Leave blank to use in-memory sessions (lost on restart).
# Set to a Redis URL for persistent, multi-instance sessions.
# Example: REDIS_URL=redis://localhost:6379
REDIS_URL=
SESSION_MAX_HISTORY=5

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Observability ────────────────────────────────────────────────────────────
# LOG_FORMAT: 'json' (structured, for log aggregators) or 'text' (human-readable)
LOG_FORMAT=json
LOG_LEVEL=INFO
